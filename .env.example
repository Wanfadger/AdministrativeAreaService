# Copy to .env and adjust. .env is gitignored — never commit real credentials.
#
# These values MUST match what your database dump expects, otherwise pg_restore
# will land the data under the wrong role/database.

# ---------- Postgres ----------
POSTGRES_DB=areadevdb
POSTGRES_USER=siip-db-user-dev
POSTGRES_PASSWORD=qwertyuftdytrsdev
POSTGRES_PORT=5437

# ---------- Redis ----------
REDIS_PORT=8101
REDIS_INSIGHT_PORT=8001
REDIS_MAXMEMORY=1gb

# ---------- API ----------
API_PORT=8084
APP_PROFILE=dev1
# Flyway owns the schema; 'validate' refuses to start on drift.
DDL_AUTO=validate

# ---------- UI ----------
UI_PORT=4200

# ---------- Observability ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---------- CORS (browsers only) ----------
# CORS is enforced by the BROWSER. It does NOT restrict integrating services — another Spring app, a
# Python job or curl sends no Origin header and never consults these headers. This list controls which
# WEB FRONT ENDS may call the API from a user's browser.
#
# Empty is correct for the compose stack: the console is served by nginx, which proxies /api/ to the
# API, so it is same-origin and CORS never applies. Set this only for a browser app served elsewhere,
# such as the Angular dev server. Comma-separated; exact origins, not patterns.
#   CORS_ORIGINS=http://localhost:4200,https://console.internal.example.com
CORS_ORIGINS=

# ---------- Rate limiting (per client, per pod) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=300
# ONLY true behind a proxy you control (compose's nginx). Otherwise X-Forwarded-For is attacker-supplied.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
