# Copy to .env and adjust. .env is gitignored — never commit real credentials.
#
# These values MUST match what your database dump expects, otherwise pg_restore
# will land the data under the wrong role/database.

# ---------- Postgres ----------
POSTGRES_DB=areadevdb
POSTGRES_USER=siip-db-user-dev
POSTGRES_PASSWORD=qwertyuftdytrsdev
POSTGRES_PORT=5437

# ---------- Redis ----------
REDIS_PORT=8101
REDIS_INSIGHT_PORT=8001
REDIS_MAXMEMORY=1gb

# ---------- API ----------
API_PORT=4401
APP_PROFILE=dev1
# Flyway owns the schema; 'validate' refuses to start on drift.
DDL_AUTO=validate

# ---------- UI ----------
UI_PORT=4200

# The console is a compiled bundle with no environment variables of its own, so these two are written
# into config.js when its container starts. Changing either needs a restart, never a rebuild.
#
# Origin of the API as the BROWSER reaches it. Empty = same origin, via nginx's /api/ proxy. That is
# the default and is what you want; set it only when the API is served from another host, and then add
# this console's origin to CORS_ORIGINS below.
UI_API_URL=
#
# Where the header's "API Docs" link points. Leave it commented for the same-origin Swagger UI.
# Uncomment as an EMPTY value to remove the link — and set API_DOCS_ENABLED=false too, or the docs stay
# served and are merely unlinked.
# UI_DOCS_URL=

# ---------- API docs ----------
# Serves both /swagger-ui.html and /v3/api-docs. false withdraws them.
API_DOCS_ENABLED=true
#
# Extra server offered in Swagger's dropdown, which is what "Try it out" calls. Empty here because the
# always-present http://localhost:4401 entry is already correct in development. In a deployment set it
# to the origin the browser reaches — nginx's public origin, NOT the API's published port, or every
# "Try it out" call becomes cross-origin and is blocked. E.g. OPENAPI_SERVER_URL=http://154.72.196.32:5002
OPENAPI_SERVER_URL=

# ---------- Observability ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ---------- CORS (browsers only) ----------
# CORS is enforced by the BROWSER. It does NOT restrict integrating services — another Spring app, a
# Python job or curl sends no Origin header and never consults these headers. This list controls which
# WEB FRONT ENDS may call the API from a user's browser.
#
# Empty is correct for the compose stack: the console is served by nginx, which proxies /api/ to the
# API, so it is same-origin and CORS never applies. Set this only for a browser app served elsewhere,
# such as the Angular dev server. Comma-separated; exact origins, not patterns.
#   CORS_ORIGINS=http://localhost:4200,https://console.internal.example.com
CORS_ORIGINS=

# ---------- Rate limiting (per client, per pod) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=300
# Only safe to enable when a proxy you control is the ONLY way to reach the API. It is not, while the
# api service publishes 4401 — a caller that skips nginx sets X-Forwarded-For itself, rotates it per
# request, and is never limited. Leave false unless you have removed that published port.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
