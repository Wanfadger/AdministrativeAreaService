{
  "uid": "administrative-area",
  "title": "Administrative Area API",
  "tags": ["administrative-area", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": "label_values(aa_cache_l1_hits_total, region)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cache — is it actually working?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Overall hit ratio",
      "description": "Reads served from either cache tier. Anything below ~90% on this workload means the cache is being evicted more often than it is being used — check the eviction rate and the write rate.",
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(aa_cache_l1_hits_total[5m])) + sum(rate(aa_cache_l2_hits_total[5m]))) / clamp_min(sum(rate(aa_cache_l1_hits_total[5m])) + sum(rate(aa_cache_l2_hits_total[5m])) + sum(rate(aa_cache_misses_total[5m])), 0.0001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "L2 (Redis) errors",
      "description": "THE ONE TO ALERT ON. Non-zero means Redis is failing and the service is quietly running on L1 + Postgres alone. It stays up — that is by design — and nothing else will tell you.",
      "gridPos": { "h": 6, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(increase(aa_cache_l2_errors_total[5m]))", "legendFormat": "errors (5m)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reads by tier",
      "description": "L1 is in-heap (~100ns). L2 is Redis (~1-3ms, shared). A miss reached Postgres. A high L2 rate with a low L1 rate means the in-heap tier is being evicted too aggressively — its weight bound is too tight, or writes are evicting too often.",
      "gridPos": { "h": 6, "w": 14, "x": 10, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [
        { "expr": "sum(rate(aa_cache_l1_hits_total{region=~\"$level\"}[1m]))", "legendFormat": "L1 (heap)" },
        { "expr": "sum(rate(aa_cache_l2_hits_total{region=~\"$level\"}[1m]))", "legendFormat": "L2 (redis)" },
        { "expr": "sum(rate(aa_cache_misses_total{region=~\"$level\"}[1m]))", "legendFormat": "miss (postgres)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hit ratio per level",
      "description": "Split per cache region, which is why there are twelve of them. A single global number hides a level that never hits.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "(rate(aa_cache_l1_hits_total[5m]) + rate(aa_cache_l2_hits_total[5m])) / clamp_min(rate(aa_cache_l1_hits_total[5m]) + rate(aa_cache_l2_hits_total[5m]) + rate(aa_cache_misses_total[5m]), 0.0001)",
          "legendFormat": "{{region}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "L1 evictions",
      "description": "If these climb on the aa_search_* regions, entries are being pushed out by the weight bound rather than expiring — app.cache.search-max-weight is too low for the traffic.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "expr": "sum by (cache) (rate(cache_evictions_total[5m]))", "legendFormat": "{{cache}}" }
      ]
    },
    {
      "type": "row",
      "title": "Latency and traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status",
      "description": "304s are conditional requests answered without querying, mapping or serializing anything. 429s are the rate limiter.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "row",
      "title": "Resources — the real throughput ceiling",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Hikari: active vs pending",
      "description": "The actual limit on this service. Virtual threads removed the web thread pool, so nothing throttles requests before the connection pool any more — PENDING climbing above zero means requests are queueing for a connection, and that is the signal that the cache is not absorbing what it should.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "PENDING (queueing)" },
        { "expr": "hikaricp_connections_max", "legendFormat": "pool max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "description": "The L1 cache lives in here. Watch it against app.cache.search-max-weight.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC pause",
      "description": "Relevant beyond the usual: a GC-paused pod can miss a Redis pub/sub invalidation, and its in-heap tier then stays stale until the L1 TTL expires.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "{{action}} ({{cause}})" }
      ]
    }
  ]
}
